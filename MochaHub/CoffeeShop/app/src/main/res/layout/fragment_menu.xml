<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <!-- Top bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@color/colorSecondary">

            <TextView
                android:id="@+id/menuGreetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="false"
                android:layout_centerVertical="false"
                android:layout_marginStart="16dp"
                android:text="Good morning coffee lover !"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="70dp"/>

            <ImageButton
                android:id="@+id/cartButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="false"
                android:layout_marginEnd="14dp"
                android:background="@android:color/transparent"
                android:contentDescription="Cart"
                android:src="@drawable/ic_cart"
                android:layout_marginTop="65dp"/>
        </RelativeLayout>

        <!-- Search field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/rounded_corner_white"
            android:elevation="2dp"
            android:padding="8dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                android:layout_gravity="center"
                android:tint="#B0B0B0"
                android:contentDescription="Search"/>
            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search anything"
                android:textColor="#000000"
                android:textSize="16sp"
                android:background="@android:color/transparent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:inputType="text"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- Menu specials -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corner_white"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="14dp"
            android:elevation="2dp"
            android:padding="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:src="@drawable/img_espresso1"
                android:contentDescription="Premium Espresso"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_corner_white"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Premium Espresso"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Espresso in premium quality"
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$3.50"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary"/>
                </LinearLayout>

                <Button
                    android:id="@+id/addMenuEspressoButton"
                    android:layout_width="92dp"
                    android:layout_height="40dp"
                    android:background="@drawable/button_bg"
                    android:text="+ Add"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corner_white"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="14dp"
            android:elevation="2dp"
            android:padding="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:src="@drawable/img_espresso2"
                android:contentDescription="Americano"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_corner_white"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Americano"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Americano for start the day"
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$5.50"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary"/>
                </LinearLayout>

                <Button
                    android:layout_width="92dp"
                    android:layout_height="40dp"
                    android:background="@drawable/button_bg"
                    android:text="+ Add"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corner_white"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="14dp"
            android:elevation="2dp"
            android:padding="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:src="@drawable/img_espresso"
                android:contentDescription="Premium Espresso"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_corner_white"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Espresso"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="For coffee lovers only"
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$3.00"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary"/>
                </LinearLayout>

                <Button
                    android:id="@+id/addMenuEspressoButton2"
                    android:layout_width="92dp"
                    android:layout_height="40dp"
                    android:background="@drawable/button_bg"
                    android:text="+ Add"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
