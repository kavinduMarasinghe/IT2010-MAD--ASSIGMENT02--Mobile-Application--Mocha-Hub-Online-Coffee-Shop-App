<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <!-- Top bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@color/colorSecondary">

            <TextView
                android:id="@+id/profileGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="false"
                android:layout_marginStart="16dp"
                android:text="Good morning coffee lover !"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="70dp"/>

            <ImageButton
                android:id="@+id/cartButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="false"
                android:layout_marginEnd="14dp"
                android:background="@android:color/transparent"
                android:contentDescription="Cart"
                android:src="@drawable/ic_cart"
                android:layout_marginTop="65dp"/>
        </RelativeLayout>

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="@color/colorSecondary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="22dp" />

        <!-- Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="horizontal"
            android:background="@drawable/card_bg"
            android:clipToOutline="true"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="12dp"
            android:padding="18dp">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/ic_avatar"
                android:layout_marginEnd="18dp"
                android:contentDescription="Profile Avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hashani Imanga"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gold Member"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_star"
                        android:layout_marginEnd="2dp"
                        android:contentDescription="Premium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Premium Customer"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Stats row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:layout_marginHorizontal="22dp">

            <!-- Stat Card: Orders -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner_white"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clipToOutline="true"
                android:layout_marginEnd="8dp"
                android:padding="10dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_coffee"
                    android:contentDescription="Orders"
                    app:tint="@color/colorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="47"
                    android:textColor="@color/colorSecondary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Orders"
                    android:textColor="@color/colorSecondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Stat Card: Points -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner_white"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clipToOutline="true"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:padding="10dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_points"
                    android:contentDescription="Points"
                    app:tint="@color/colorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="847"
                    android:textColor="@color/colorSecondary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Points"
                    android:textColor="@color/colorSecondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Stat Card: Saved -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner_white"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clipToOutline="true"
                android:layout_marginStart="8dp"
                android:padding="10dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_saved"
                    android:contentDescription="Saved"
                    app:tint="@color/colorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$124"
                    android:textColor="@color/colorSecondary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved"
                    android:textColor="@color/colorSecondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Contact Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corner_white"
            android:elevation="2dp"
            android:padding="18dp"
            android:layout_marginHorizontal="22dp"
            android:clipToOutline="true"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Contact Information"
                    android:textColor="@color/colorSecondary"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <ImageButton
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_edit"
                    android:background="@android:color/transparent"
                    android:contentDescription="Edit"
                    app:tint="@color/colorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_email"
                        android:tint="@color/colorSecondary"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Email" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hashani@gmail.com"
                        android:textColor="#47311D"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_phone"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Phone"
                        app:tint="@color/colorSecondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+94 77 111 1234"
                        android:textColor="#47311D"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Location"
                        app:tint="@color/colorSecondary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="123, Main St, Colombo"
                        android:textColor="#47311D"
                        android:textSize="15sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Recent Orders Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corner_white"
            android:elevation="2dp"
            android:padding="18dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="22dp"
            android:clipToOutline="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recent Orders"
                android:textColor="@color/colorSecondary"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#EEE"
                android:layout_marginTop="7dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Espresso Coffee"
                    android:textColor="@color/colorSecondary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$7.70"
                    android:textColor="@color/colorSecondary"
                    android:textSize="15sp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today, 2:30 PM"
                android:textColor="#47311D"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#EEE"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cold Brew"
                    android:textColor="@color/colorSecondary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$5.70"
                    android:textColor="@color/colorSecondary"
                    android:textSize="15sp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today, 9.30 AM"
                android:textColor="#47311D"
                android:textSize="13sp"
                android:layout_marginBottom="2dp"/>

            <Button
                android:id="@+id/viewAllOrdersButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/button_bg"
                android:text="View All Orders"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!-- Rounded Sign Out Button with Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:layout_marginHorizontal="22dp">

            <Button
                android:id="@+id/signOutButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/rounded_red_button"
                android:text="Sign Out"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:drawablePadding="12dp"
                android:elevation="3dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
