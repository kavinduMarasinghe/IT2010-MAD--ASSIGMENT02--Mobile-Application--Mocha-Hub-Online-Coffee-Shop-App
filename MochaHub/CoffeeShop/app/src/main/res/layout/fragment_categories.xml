                    android:layout_height="40dp"
                    android:background="@drawable/button_bg"
                    android:text="+ Add"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:layout_gravity="end"/>
