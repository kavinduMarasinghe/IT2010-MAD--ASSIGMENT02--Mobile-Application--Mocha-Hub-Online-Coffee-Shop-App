<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Top bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good morning coffee lover !"
                android:textColor="@color/colorSecondary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <ImageButton
                android:id="@+id/cartButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_cart"
                android:layout_alignParentEnd="true"
                android:contentDescription="Cart"
                app:tint="@color/colorSecondary"/>
        </RelativeLayout>

        <!-- Banner with call to action -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/colorSecondary"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="4dp"
            android:clipToOutline="true"
            android:backgroundTint="@color/colorSecondary"
            android:elevation="4dp"
            android:layout_gravity="center"
            android:padding="0dp">

            <ImageView
                android:id="@+id/bannerImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/banner_coffee"
                android:scaleType="centerCrop"
                android:contentDescription="Coffee banner"
                android:layout_alignParentTop="true" />

            <TextView
                android:id="@+id/bannerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start your day right"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="24sp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="24dp"
                android:layout_marginTop="30dp"
                android:layout_alignParentTop="true" />

            <TextView
                android:id="@+id/bannerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good morning coffee lover !"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_below="@id/bannerTitle"
                android:layout_alignStart="@id/bannerTitle"
                android:layout_marginTop="2dp" />

            <Button
                android:id="@+id/orderNowButton"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:background="@drawable/button_bg"
                android:text="Order now"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_below="@id/bannerSubtitle"
                android:layout_alignStart="@id/bannerTitle"
                android:layout_marginTop="16dp" />
        </RelativeLayout>

        <!-- Quick actions row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:gravity="center">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_coffee"
                    android:contentDescription="Reorder"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reorder Favourite"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <Space android:layout_width="12dp" android:layout_height="1dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:gravity="center">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_quick_order"
                    android:contentDescription="Quick order"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick order"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <Space android:layout_width="12dp" android:layout_height="1dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:gravity="center">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_deals"
                    android:contentDescription="Today's deals"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's deals"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Specials section title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's specials"
            android:textColor="@color/colorSecondary"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"/>

        <!-- Specials - item 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:backgroundTint="@color/white"
            android:clipToOutline="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:elevation="2dp"
            android:layout_gravity="center"
            android:background="@drawable/rounded_corner_white">

            <!-- Product image -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:src="@drawable/img_espresso6"
                android:contentDescription="Espresso"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_corner_white"
                android:layout_marginBottom="6dp"/>

            <!-- Product details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Iced Mocha"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Iced mocha with ice cream"
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$5.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary"/>
                </LinearLayout>

                <Button
                    android:id="@+id/addEspressoButton"
                    android:layout_width="95dp"
                    android:layout_height="40dp"
                    android:background="@drawable/button_bg"
                    android:text="+ Add"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Specials - item 2, copy for more specials -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:backgroundTint="@color/white"
            android:clipToOutline="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:elevation="2dp"
            android:layout_gravity="center"
            android:background="@drawable/rounded_corner_white">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:src="@drawable/img_espresso3"
                android:contentDescription="Espresso"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_corner_white"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Premium Espresso"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="For true coffee lovers"
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$3.50"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary"/>
                </LinearLayout>

                <Button
                    android:id="@+id/addEspressoButton2"
                    android:layout_width="95dp"
                    android:layout_height="40dp"
                    android:background="@drawable/button_bg"
                    android:text="+ Add"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Loyalty Points Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:backgroundTint="@color/white"
            android:clipToOutline="true"
            android:background="@drawable/rounded_corner_white"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loyalty Points"
                    android:textStyle="bold"
                    android:textColor="@color/colorSecondary"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You have 847 points"
                    android:textColor="@color/colorSecondary"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="847"
                android:textSize="22sp"
                android:textColor="@color/colorSecondary"
                android:textStyle="bold"
                android:layout_marginEnd="16dp"/>

            <Button
                android:id="@+id/redeemButton"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:background="@drawable/button_bg"
                android:text="Redeem"
                android:textColor="@color/white"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
